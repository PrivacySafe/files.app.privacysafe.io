  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build:deno": "bash ci/bundle-deno-code.sh",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint",
    "test": "pnpm run clean:coverage && jest",
    "test:watch": "pnpm run clean:coverage && jest --watch"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.3.9",
    "dayjs": "1.11.20",
    "file-type": "22.0.0",
    "hash-wasm": "4.12.0",
    "lodash": "4.18.1",
    "pdfjs-dist": "5.6.205",
    "pinia": "3.0.4",
    "vue": "3.5.32",
    "vue-i18n": "11.3.2",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/devtools": "8.1.1",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vuedx/typescript-plugin-vue": "0.7.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "postcss-html": "1.8.1",
    "prettier": "3.8.1",
    "sass": "1.99.0",
    "stylelint": "17.6.0",
    "stylelint-config-recommended-scss": "17.0.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "vite": "8.0.7",
    "vite-plugin-vue-devtools": "8.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6"
  },
  "packageManager": "pnpm@10.32.1"
}
