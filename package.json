  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build:deno": "bash ci/bundle-deno-code.sh",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint",
    "test": "pnpm run clean:coverage && jest",
    "test:watch": "pnpm run clean:coverage && jest --watch"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.3.50",
    "dayjs": "1.11.23",
    "file-type": "22.0.2",
    "hash-wasm": "4.12.0",
    "lodash": "4.18.1",
    "pdfjs-dist": "5.7.284",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vuedx/typescript-plugin-vue": "0.7.6",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "stylelint": "17.14.1",
